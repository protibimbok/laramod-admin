{
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "paths": {
            "@/components/ui/*": ["./stubs/components/ui/*"],
            "@/hooks/*": ["./stubs/hooks/*"]
        }
    },
    "include": ["resources/js", "stubs", "tests/js", "vitest.config.ts"]
}
